<Project Sdk="Godot.NET.Sdk/4.8.0-dev.6">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- The simulation library is built as its own project. Do not compile its files here. -->
    <Compile Remove="simulation/**" />
    <None Remove="simulation/**" />
    <EmbeddedResource Remove="simulation/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="simulation/FightingGame.Simulation.csproj" />
  </ItemGroup>
</Project>
